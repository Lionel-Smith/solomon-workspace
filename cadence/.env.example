# HFS Cadence Layer — required environment variables
#
# Source of truth for SETUP-00 task 5 verification.
# Copy this file to `hfs-aiops/.env` (gitignored) and populate from the
# locations noted below, then `source hfs-aiops/.env` before SETUP-00.
#
# Provisioning strategy:
# - HARVEST: pull existing values from droplet `solomon-HFS` (ssh solomon)
#            and/or existing project configs where the var is already in use
# - GENERATE: create fresh; net-new for v1.1
# - PROVISION: create via external service console (Twilio, Anthropic console)
#
# NEVER commit a populated copy. .env belongs in .gitignore.

# === Anthropic ===

# Workspace API key for agent runs. Existing — harvest from droplet.
# Source: /home/clawdbot/.clawdbot/clawdbot.json or droplet env
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Admin-scope key for: (a) token-spend tracking via admin API,
# (b) Routines API list/get/trigger endpoints. Distinct from API key.
# Provisioning: console.anthropic.com → Admin → API Keys. Rotate quarterly.
# OQ-08 ref: stored in hfs-aiops env, rotated quarterly.
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-REPLACE_ME

# === Slack ===

# Bot token for posting to #dev-news, #solomon-standup, #cadence-status,
# #ci-failures and for receiving slash commands (/learn, /audit-claude,
# /cadence-status, /routine-status).
# Existing — harvest from droplet clawdbot.json (Slack already wired).
SLACK_BOT_TOKEN=xoxb-REPLACE_ME

# Signing secret for HMAC verification of inbound Slack webhooks
# (promotion approve/reject button webhooks).
# Existing — harvest from droplet clawdbot.json.
SLACK_SIGNING_SECRET=REPLACE_ME

# === Twilio WhatsApp Business API ===

# Net-new for v1.1. Provisioning required:
# 1. Create / log into Twilio account (twilio.com)
# 2. Onboard WhatsApp Business sender (Twilio docs)
# 3. Copy Account SID + Auth Token from console.twilio.com
# 4. Note the assigned WhatsApp-enabled number (E.164 format)
# OQ-04 ref: Routine connector preferred; Samson cross-post fallback.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# === Mem0 ===

# Persistent memory across sessions. Per workspace CLAUDE.md, MEM0_API_KEY
# is provisioned in the OpenClaw sandbox env on the droplet.
# Existing — harvest from droplet sandbox env or app.mem0.ai console.
MEM0_API_KEY=REPLACE_ME

# === Database ===

# hfs-aiops Postgres (existing). Format:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Local dev: typically points at a local postgres or a tunnel to DO Postgres.
# Existing — harvest from current hfs-aiops droplet env or .env if present.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/hfs_aiops

# === Samson internal auth ===

# Net-new for v1.1. Used by:
# - Routines to authenticate back to Samson (e.g., friday-retro Routine
#   calls GET /cadence/learnings/queued with this token)
# - Slack/WhatsApp webhook → REST endpoint authentication
# Generate: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# After generation, store the same value in the Anthropic Routine secret store
# so Routines can authenticate as Samson's caller.
SAMSON_INTERNAL_TOKEN=REPLACE_ME

# === End of required variables ===
#
# SETUP-00 verification expects ≥ 8 of the above 10 set. To verify locally:
#   env | grep -cE '^(ANTHROPIC|SLACK|TWILIO|MEM0|SAMSON|DATABASE)_'
#
# Optional variables that will be added in later sessions:
# - OTEL_EXPORTER_OTLP_ENDPOINT (OPS-02)
# - GITHUB_TOKEN for apply-worker PR creation (BE-06; uses solomon-bot PAT)
# - LINEAR_API_KEY for eval-drift + CI-triage issue creation (BE-09, BE-08)
